{
  // Cloudflare Workers with static assets (deploy command: npx wrangler deploy).
  // The name must match the name of the Worker in the Cloudflare dashboard.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "planning-poker",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    // Direct requests to /r/<token> serve index.html (single-page app).
    "not_found_handling": "single-page-application"
  }
}
